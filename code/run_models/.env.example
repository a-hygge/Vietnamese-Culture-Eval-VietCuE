# Copy file này thành .env và điền API keys vào.
# Anh có key nào điền key đó — thiếu key thì model tương ứng sẽ fail nhưng các model khác vẫn chạy.

# ====== CLOSE-SOURCE (qua LiteLLM) ======
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...           # cho Gemini
DEEPSEEK_API_KEY=sk-...
DASHSCOPE_API_KEY=sk-...         # cho Qwen API (DashScope)
XAI_API_KEY=xai-...              # cho Grok

# Azure OpenAI (optional — chỉ cần nếu chạy gpt-5-azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://....openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ====== OPEN-SOURCE (qua NVIDIA NIM) ======
# Lấy key free tier: https://build.nvidia.com  (1000 credit/key/tháng)
# Hỗ trợ multi-key rotation — có nhiều key thì điền hết, code tự switch khi rate limit
NVIDIA_API_KEY=nvapi-...
NVIDIA_API_KEY_2=nvapi-...
NVIDIA_API_KEY_3=nvapi-...
